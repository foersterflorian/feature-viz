# Copy to .env (git-ignored) and adjust to this machine. Read by compose.yaml.

# Stable camera path; /dev/videoN numbers can shift across reboots, and UVC
# cameras expose a second, metadata-only node. List: ls /dev/v4l/by-id/
CAMERA_DEVICE=/dev/v4l/by-id/usb-EXAMPLE-video-index0

# Numeric GID of the host's video group: getent group video
VIDEO_GID=44

# Port on the host; inside the container the demonstrator always uses 8080.
HOST_PORT=8080
